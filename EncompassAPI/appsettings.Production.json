{
  "LoggingConfig": {
    "VerboseLogging": true
  },
  "AllowedHosts": "*",
  "AWSConfig": {
    "SecretPath": "api/prod",
    "SecurityKeysPath": "encompass/securitykeys",
    "CandidDbPath": "/mysql/connectionstring",
    "DocusignSecretPath": "docusign/salesforce"
  },
  "FileConfig": {
    "LocalDownloadPath": "/app/Downloads",
    "IntialDisclosuresName": "Initial Mortgage Disclosures.pdf",
    "RevisedIntialDisclosuresName": "Revised Mortgage Disclosures.pdf",
    "InitialClosingDisclosuresName": "Initial Closing Disclosures.pdf",
    "RevisedInitialClosingDisclosuresName": "Revised Closing Disclosures.pdf"
  },
  "S3Config": {
    "AwsRegion": "us-east-1"
  },
  "EncompassConfig": {
    "BaseUrl": "https://api.elliemae.com",
    "LoanEndpointV1": "/encompass/v1/loans",
    "LoanEndpointV3": "/encompass/v3/loans",
    "TokenEndpoint": "/oauth2/v1/token",
    "IntrospectionEndpoint": "/oauth2/v1/token/introspection",
    "OpeningAuditEndpoint": "/encompassdocs/v1/documentAudits/opening",
    "OpeningDocSetEndpoint": "/encompassdocs/v1/documentOrders/opening",
    "ClosingAuditEndpoint": "/encompassdocs/v1/documentAudits/closing",
    "ClosingDocSetEndpoint": "/encompassdocs/v1/documentOrders/closing",
    "GetEFolderDocsEndpoint": "/encompass/v3/settings/efolder/documents",
    "ResourceLockEndpoint": "/encompass/v3/resourceLocks"
  },
  "SalesforceConfig": {
    "CandidPushEndpoint": "/services/apexrest/CANDIDOEM/DocumentAPIClone",
    "CandidSettingsEndpoint": "/services/data/v60.0/query/?q=SELECT+CANDIDOEM__AWS_Access_Key_Id__c+,+CANDIDOEM__Root_Folder_Name__c+,+CANDIDOEM__AWS_Secret_Access_Key__c+from+CANDIDOEM__GoogleDriveClone__c"
  },
  "DocusignConfig": {
    "BaseUrl": "https://docusign.los.candidcrm.com",
    "RequestDraftForEditingEndpoint": "/api/v2/docusign/requestDraftForEditngV4"
  },
  "CacheStorageConfig": {
    "S3Bucket": "candid-docusign-hub-prod",
    "S3CachePrefix": "docusign-document-storage",
    "S3BucketPrefix": "encompass-pdfs"
  }
}