<VSTemplate Version="3.0.0" Type="Project">
  <TemplateData>
    <Name>EncompassAPI</Name>
    <Description>An ASP.NET Core Web API project with predefined structure and dependencies.</Description>
    <ProjectType>Web</ProjectType>
    <SortOrder>10</SortOrder>
    <DefaultName>EncompassAPI</DefaultName>
    <CreateNewFolder>true</CreateNewFolder>
  </TemplateData>
  <TemplateContent>
    <Project File="$safeprojectname$.csproj">
      <Folder Name="Controllers">
        <ProjectItem ReplaceParameters="true">TokenMiddleware.cs</ProjectItem>
      </Folder>
      <Folder Name="Middleware">
        <ProjectItem ReplaceParameters="true">TokenMiddleware.cs</ProjectItem>
      </Folder>
      <Folder Name="Models">
        <ProjectItem ReplaceParameters="true">AWSConfig.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true">CommonStrings.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true">ProcessResult.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true">ResponseMessage.cs</ProjectItem>
      </Folder>
      <Folder Name="Services">
        <ProjectItem ReplaceParameters="true">AWSService.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true">HttpService.cs</ProjectItem>
      </Folder>
      <Folder Name="Utility">
        <ProjectItem ReplaceParameters="true">ModelExtensions.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true">appsettings.Development.json</ProjectItem>
        <ProjectItem ReplaceParameters="true">appsettings.json</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true">Program.cs</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>